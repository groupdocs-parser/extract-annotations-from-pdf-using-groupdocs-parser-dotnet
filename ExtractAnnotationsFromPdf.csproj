<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net6.0</TargetFramework>
    <RootNamespace>GroupDocs.Samples.ExtractAnnotationsFromPdf</RootNamespace>
    <AssemblyName>ExtractAnnotationsFromPdf</AssemblyName>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <LangVersion>latest</LangVersion>
  </PropertyGroup>

  <ItemGroup>
    <!-- Router package: resolves to the correct GroupDocs.Parser build for the target platform -->
    <PackageReference Include="GroupDocs.Parser" Version="26.7.0" />
    <PackageReference Include="System.Text.Json" Version="8.0.5" />
  </ItemGroup>

  <ItemGroup>
    <!-- Ship the sample PDF next to the built executable -->
    <None Include="resources\**\*.*">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

</Project>
